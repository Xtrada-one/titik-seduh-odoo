            <script type="text/javascript">
                console.log("🔥 SCRIPT DINAMIS TITIK SEDUH SIAP!");

                document.addEventListener("mousedown", function(event) {
                    var wrapElement = document.getElementById("wrap");
                    var introScreen = document.getElementById("intro-screen");
                    var mainWrapper = document.getElementById("main-content-wrapper");

                    if (wrapElement) {
                        if (wrapElement.contains(event.target)) {
                            if (introScreen) {
                                if (!introScreen.classList.contains("slide-up-exit")) {
                                    console.log("🚀 Masuk Ke Halaman Utama.");
                                    introScreen.classList.add("slide-up-exit");
                                    mainWrapper.classList.add("show");
                                    wrapElement.style.cursor = "default";
                                }
                            }
                        }
                    }
                });

                function gantiHalaman(targetPage) {
                    event.stopPropagation();
                    var homeView = document.getElementById("view-home");
                    var aboutView = document.getElementById("view-about");
                    var menuView = document.getElementById("view-menu");
                    var locationView = document.getElementById("view-location");
                    var contactView = document.getElementById("view-contact");
                    var menuHome = document.getElementById("menu-home");
                    var menuAbout = document.getElementById("menu-about");
                    var menuMenu = document.getElementById("menu-menu");
                    var menuLocation = document.getElementById("menu-location");
                    var menuContact = document.getElementById("menu-contact");

                    var views = [homeView, aboutView, menuView, locationView, contactView];
                    var menus = [menuHome, menuAbout, menuMenu, menuLocation, menuContact];

                    views.forEach(function(v) { if (v) v.classList.remove("active-view"); });
                    menus.forEach(function(m) { if (m) m.classList.remove("active"); });

                    if (targetPage === 'home') {
                        if (homeView) homeView.classList.add("active-view");
                        if (menuHome) menuHome.classList.add("active");
                    } else if (targetPage === 'about') {
                        if (aboutView) aboutView.classList.add("active-view");
                        if (menuAbout) menuAbout.classList.add("active");
                    } else if (targetPage === 'menu') {
                        if (menuView) menuView.classList.add("active-view");
                        if (menuMenu) menuMenu.classList.add("active");
                    } else if (targetPage === 'location') {
                        if (locationView) locationView.classList.add("active-view");
                        if (menuLocation) menuLocation.classList.add("active");
                    } else if (targetPage === 'contact') {
                        if (contactView) contactView.classList.add("active-view");
                        if (menuContact) menuContact.classList.add("active");
                    }
                }

                // --- DATA MENU DINAMIS DAN SLIDER LOGIC ---
                var menuData = {
                    'makanan': [],
                    'minuman': []
                };

                // Ambil data produk Makanan (dari QWeb)
                <t t-foreach="request.env['product.template'].sudo().search([('categ_id.name', 'ilike', 'makan')], limit=3)" t-as="p">
                    menuData['makanan'].push({
                        name: "<t t-esc="p.name"/>",
                        desc: "<t t-esc="p.description_sale or 'Spesial dari Titik Seduh'"/>",
                        image: "/web/image/product.template/<t t-esc="p.id"/>/image_1024"
                    });
                </t>
                
                // Ambil data produk Minuman (dari QWeb)
                <t t-foreach="request.env['product.template'].sudo().search([('categ_id.name', 'ilike', 'minum')], limit=3)" t-as="p">
                    menuData['minuman'].push({
                        name: "<t t-esc="p.name"/>",
                        desc: "<t t-esc="p.description_sale or 'Spesial dari Titik Seduh'"/>",
                        image: "/web/image/product.template/<t t-esc="p.id"/>/image_1024"
                    });
                </t>

                // Fallback jika tidak ada produk dari QWeb
                if (menuData['makanan'].length === 0) {
                    menuData['makanan'] = [
                        { name: "NASI GORENG SPESIAL", desc: "Nasi + Telur + Ayam + Kerupuk", image: "/titik_seduh_login/static/src/img/Bg-Titik-Seduh.jpg" },
                        { name: "MIE GORENG JAWA", desc: "Mie + Sayur + Telur", image: "/titik_seduh_login/static/src/img/Bg-Titik-Seduh.jpg" },
                        { name: "CROISSANT", desc: "Roti lapis mentega renyah", image: "/titik_seduh_login/static/src/img/Bg-Titik-Seduh.jpg" }
                    ];
                }
                if (menuData['minuman'].length === 0) {
                    menuData['minuman'] = [
                        { name: "COFFE LATTE", desc: "Espresso + Coffe + Milk", image: "/titik_seduh_login/static/src/img/Bg-Titik-Seduh.jpg" },
                        { name: "AMERICANO", desc: "Espresso + Air Mineral", image: "/titik_seduh_login/static/src/img/Bg-Titik-Seduh.jpg" },
                        { name: "MOCCACINO", desc: "Espresso + Coklat + Susu", image: "/titik_seduh_login/static/src/img/Bg-Titik-Seduh.jpg" }
                    ];
                }

                var currentCategory = 'makanan';
                var currentIndex = 0;

                function updateMenuDisplay() {
                    var items = menuData[currentCategory];
                    if (items.length > 0) {
                        var item = items[currentIndex];
                        document.getElementById('menu-product-name').innerText = item.name;
                        document.getElementById('menu-product-desc').innerText = item.desc;
                        document.getElementById('menu-image-container').style.backgroundImage = "url('" + item.image + "')";
                    }
                }

                function setCategory(cat) {
                    currentCategory = cat;
                    currentIndex = 0;
                    
                    document.getElementById('btn-cat-makanan').classList.remove('active');
                    document.getElementById('btn-cat-minuman').classList.remove('active');
                    document.getElementById('btn-cat-' + cat).classList.add('active');
                    
                    updateMenuDisplay();
                }

                function nextProduct() {
                    var items = menuData[currentCategory];
                    if(items.length > 0) {
                        currentIndex = (currentIndex + 1) % items.length;
                        updateMenuDisplay();
                    }
                }

                function prevProduct() {
                    var items = menuData[currentCategory];
                    if(items.length > 0) {
                        currentIndex = (currentIndex - 1 + items.length) % items.length;
                        updateMenuDisplay();
                    }
                }

                setTimeout(updateMenuDisplay, 100);
            </script>

        </xpath>
